+def _image_to_png_b64(img) -> str:
+    """PIL image -> base64-encoded PNG string. Stable, deterministic."""
+    buf = io.BytesIO()
+    img.convert("RGB").save(buf, format="PNG")
+    return base64.b64encode(buf.getvalue()).decode("ascii")
